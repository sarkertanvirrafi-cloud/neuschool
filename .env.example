# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://*.vercel.app
DJANGO_TIME_ZONE=Asia/Dhaka
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=3600

# Neon PostgreSQL - use the pooled connection string for serverless deployment.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# VdoCipher DRM - keep this secret on the server/Vercel only.
VDOCIPHER_API_SECRET=
# Optional VdoCipher folder ID for browser uploads.
VDOCIPHER_FOLDER_ID=
# Optional playback domain regex. Configure after your production domain is known.
# Example: neuschool\.com
VDOCIPHER_ALLOWED_DOMAIN=
VDOCIPHER_OTP_TTL=300
VDOCIPHER_WATERMARK_ENABLED=1

# Cloudinary for course banners/materials. Video files go directly to VdoCipher.
CLOUDINARY_URL=

# Footer
SITE_ADDRESS=Address will be added here.
SITE_CONTACT=Contact info will be added here.

# Optional first admin bootstrap during Vercel deployment.
ADMIN_NAME=NeuSchool Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
